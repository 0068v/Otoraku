<% if flash[:notice] %>
  <%= flash[:notice] %>
<% end %>

<% @songs.each do |song| %>
  <p>
    <tr>
      <td><%= song.title %></td>
      
      <br>

      <td>
        <% if song.image.present? %>
          <%= image_tag image_song_path(song), width: 120 %>
        <% end %>
      </td>
      
      <td colspan="2">&nbsp;</td>
      
      <td>
        <%= link_to '表示', song_path(song) %>
        <%= link_to '編集', edit_song_path(song) %>
        <%= link_to '削除', song, data: {turbo_method: :delete} %>
      </td>
    </tr>
  </p>
<% end %>

<p><%= link_to '新規追加', '/songs/new' %></p>